<comment>
problem   = Toyouchi test
reference = 
configure = --prob=Toyouchi --grav=mg/fft (-fft)

<units>
unit_system = custom
mass_cgs = 1.98847e33        # M0 = 1 Msun
time_cgs    = 3.15576e10     # T0 = 1 kyr
length_cgs  = 1.495978707e15 # L0 = 100 au

<job>
problem_id = Toyouchi    # problem ID: basename of output filenames

<output1>
file_type  = hst        # History data dump
dt         = 0.2 # code time [kyr]

<output2>
file_type  = vtk        # Binary data dump
variable   = prim,gr_nfw,gr_star,gself_x,gself_y,gself_z,apres_x,apres_y,apres_z,amag_x,amag_y,amag_z       # variables to be output
dt         = 0.2 # code time [kyr]
ghost_zones= false

<output3>
file_type = rst
dt        = 10.032353537658 # code time [kyr]

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1      # -1は無制限
tlim       = 20.0 # code time [kyr]
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1        = 40         # Number of zones in X1-direction
x1min      = -1000       # -100000 au
x1max      = 1000        # +100000 au
ix1_bc     = outflow   # inner-X1 boundary flag
ox1_bc     = outflow   # outer-X1 boundary flag

nx2        = 40         # Number of zones in X2-direction
x2min      = -1000       # -100000 au
x2max      = 1000        # +100000 au
ix2_bc     = outflow   # inner-X2 boundary flag
ox2_bc     = outflow   # outer-X2 boundary flag

nx3        = 40         # Number of zones in X3-direction
x3min      = -1000       # -100000 au
x3max      = 1000        # +100000 au
ix3_bc     = outflow   # inner-X3 boundary flag
ox3_bc     = outflow   # outer-X3 boundary flag

#SMR
refinement = static
<refinement1>
x1min = -20.206838411905  # code unit
x1max =  20.206838411905
x2min = -20.206838411905
x2max =  20.206838411905
x3min = -20.206838411905
x3max =  20.206838411905
level = 5


<meshblock>
nx1        = 8
nx2        = 8
nx3        = 8

<hydro>
gamma           = 1.001            # gamma = C_p/C_v ~等温
sound_speed_kms = 5.8146878969959 # isothermal: T=5e3 K, mu=1.22
                                  # kB=1.380649e-16, mH=1.6735575e-24 (CGS)
dfloor          = 1.93843485042648e-08 # code density; same physical floor

<gravity>
mgmode          = FMG
threshold       = 0.0
mporder         = 2
ix1_bc          = multipole
ox1_bc          = multipole
ix2_bc          = multipole
ox2_bc          = multipole
ix3_bc          = multipole
ox3_bc          = multipole

<problem>
# Wise19 central velocity continuation
vr_taper_au = 580.0

# 初期密度へのWhite noise
use_density_noise     = true
density_noise_percent = 1.0
density_noise_seed    = 42  # ゆらぎのパターンを決める番号

mstar_init          = 100  # 固定中心星質量(code mass = 1 Msun; no accretion update)
use_central_gravity = true
use_nfw_gravity     = true
# G is calculated by Units from the CGS gravitational constant.
use_rotation      = true  # MMH fitによる円筒回転
use_radial_inflow = true  # MMH fitによる球対称内向き降着流

# 磁場関連
bz_microgauss = 0  #磁場Bzの強さ(μG単位) 
eta_ohm  = 0.0  # Ohmic拡散：磁場を散逸・平滑化し、蓄積した磁束を逃がす ※0.1を使うこと
eta_hall = 0.0   # Hall効果：磁場を散逸させず、磁場の構造・向きを変化させる ※使用の必要なし
eta_ad   = 0.0   # 両極性拡散：弱電離ガス中で中性粒子と磁場を相対的に滑らせる ※使用の必要なし


